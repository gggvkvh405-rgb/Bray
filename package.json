{
  "name": "byazen",
  "version": "1.0.22",
  "description": "ByAzen — минималистичный тёмный браузер",
  "author": "ByAzen",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "dist:win": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "express": "^4.19.2",
    "node-edge-tts": "^1.2.12"
  },
  "build": {
    "appId": "app.byazen.browser",
    "productName": "ByAzen",
    "compression": "normal",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "extraResources": [
      {
        "from": "resources/piper",
        "to": "piper",
        "filter": ["**/*"]
      }
    ],
    "files": [
      "electron/**",
      "public/**",
      "server.js",
      "package.json",
      "node_modules/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "ByAzen.exe"
    }
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0"
  }
}
